# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure OpenAI (for the reasoning step)
AZURE_OPENAI_RESOURCE=entraguard-aoai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Foundry IQ (for the agentic knowledge retrieval step)
# When set, EntraGuard calls the Azure AI Search agentic-retrieval endpoint
# that powers Foundry IQ. When empty, it falls back to a deterministic
# scoring over a bundled set of real public threat-intel sources. The UI
# shows a badge indicating which path produced the citations.
FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_API_KEY=
FOUNDRY_IQ_API_VERSION=2026-04-01

# Demo behavior
DEMO_OPERATOR_EMAIL=priya.shah@contoso.com
DEMO_USE_CACHE=true
DEMO_FALLBACK_ON_ERROR=true
